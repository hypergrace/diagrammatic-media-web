---
layout: simple.njk
title: grace grace grace
---

{%- set categoryOrder = [
  {key: "performance",             label: "performance"},
  {key: "installation-visual-art", label: "installation + visual art"},
  {key: "writing-research",        label: "writing + research"},
  {key: "synthesizers",            label: "synthesizers"},
  {key: "curation-organization",   label: "curation + organization"}
] -%}

{%- set allTags = [] -%}
{%- for p in collections.project -%}
  {%- if p.data.projecttags -%}
    {%- set parts = p.data.projecttags.split(',') -%}
    {%- for t in parts -%}
      {%- set clean = t.trim() -%}
      {%- if clean and clean not in allTags -%}
        {%- set allTags = (allTags.push(clean), allTags) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

<h1 class ="h1-fill">{{title}}</h1>

<div class="portfolio-filters">
  <div class="category-filters">
    <button class="cat-filter active" data-key="all">ALL</button>
    {%- for cat in categoryOrder -%}
      <button class="cat-filter" data-key="{{ cat.key }}">{{ cat.label }}</button>
    {%- endfor -%}
  </div>
  <div class="tag-filters">
    {%- for t in allTags -%}
      <button class="tag-filter" data-rawtag="{{ t }}">#{{ t }}</button>
    {%- endfor -%}
  </div>
</div>

<div class="portfolio-grid">
  {%- for p in collections.project | reverse -%}
    {%- set urlParts = p.url.split('/') -%}
    {%- set slug = urlParts[3] -%}
    {%- set thumb = projectThumbnails[slug] -%}
    <a href="{{ p.url }}" class="portfolio-item" data-category="{{ p.data.category }}" data-tags="{{ p.data.projecttags }}">
      {%- if thumb -%}
        <img src="{{ thumb }}" alt="{{ p.data.title }}" loading="lazy">
      {%- else -%}
        <div class="thumb-placeholder"></div>
      {%- endif -%}
      <div class="portfolio-title">{{ p.data.title }}{% if p.data.year %} <span class="portfolio-year">({{ p.data.year }})</span>{% endif %}</div>
    </a>
  {%- endfor -%}
</div>

<script>
(function() {
  var grid    = document.querySelector('.portfolio-grid');
  var allItems = Array.from(document.querySelectorAll('.portfolio-item'));
  var catBtns = document.querySelectorAll('.cat-filter');
  var tagBtns = document.querySelectorAll('.tag-filter');

  /* ---- masonry ---- */
  function numCols() {
    var w = window.innerWidth;
    if (w <= 480) return 1;
    if (w <= 720) return 2;
    return 3;
  }

  function masonry() {
    var visible = allItems.filter(function(el) { return el.style.display !== 'none'; });
    var cols    = numCols();
    var gap     = 12;
    var gridW   = grid.offsetWidth;
    var colW    = (gridW - gap * (cols - 1)) / cols;
    var heights = new Array(cols).fill(0);

    visible.forEach(function(item) {
      item.style.width = colW + 'px';
      // find leftmost shortest column → left-to-right row-by-row ordering
      var minH = Math.min.apply(null, heights);
      var col  = heights.indexOf(minH);
      item.style.left = (col * (colW + gap)) + 'px';
      item.style.top  = heights[col] + 'px';
      heights[col]   += item.offsetHeight + gap;
    });

    grid.style.height = Math.max.apply(null, heights) + 'px';
  }

  /* wait for images then lay out */
  function layoutWhenReady() {
    var imgs = Array.from(grid.querySelectorAll('img'));
    var pending = imgs.filter(function(img) { return !img.complete; });
    if (pending.length === 0) { masonry(); return; }
    var done = 0;
    pending.forEach(function(img) {
      function onLoad() { if (++done === pending.length) masonry(); }
      img.addEventListener('load', onLoad);
      img.addEventListener('error', onLoad);
    });
  }

  /* ---- filter ---- */
  function clearActive() {
    catBtns.forEach(function(b) { b.classList.remove('active'); });
    tagBtns.forEach(function(b) { b.classList.remove('active'); });
  }

  function filterItems(test) {
    allItems.forEach(function(item) {
      item.style.display = test(item) ? '' : 'none';
    });
    masonry();
  }

  catBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      clearActive();
      btn.classList.add('active');
      var key = btn.dataset.key;
      filterItems(function(item) { return key === 'all' || item.dataset.category === key; });
    });
  });

  tagBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      clearActive();
      btn.classList.add('active');
      var tag = btn.dataset.rawtag;
      filterItems(function(item) {
        if (!item.dataset.tags) return false;
        return item.dataset.tags.split(',').map(function(t) { return t.trim(); }).includes(tag);
      });
    });
  });

  /* ---- init & resize ---- */
  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(masonry, 120);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', layoutWhenReady);
  } else {
    layoutWhenReady();
  }
})();
</script>
