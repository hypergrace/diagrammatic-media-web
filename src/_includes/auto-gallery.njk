{% comment %}
  Auto Gallery
  Reads images from /projects/{slug}/gallery/ via projectGalleries data.
  project_folder is auto-derived from page.url; override via frontmatter if needed.
  gallery_columns  — grid columns (default 3)
  gallery_preview  — images shown before "Show all" button (default 3)
{% endcomment %}
{% unless project_folder %}
  {% assign url_parts = page.url | split: "/" %}
  {% assign project_folder = url_parts[3] %}
{% endunless %}
{% assign project_images = projectGalleries[project_folder] %}
{% if project_images and project_images.size > 0 %}
  {% assign gallery_id  = "gallery-" | append: project_folder %}
  {% assign cols        = gallery_columns | default: 3 %}
  {% assign preview     = gallery_preview | default: 3 %}
  {% assign total       = project_images.size %}
  {% if total > preview %}{% assign truncated = true %}{% else %}{% assign truncated = false %}{% endif %}

<div class="photo-gallery{% if truncated %} gallery-truncated{% endif %}"
     data-columns="{{ cols }}"
     id="{{ gallery_id }}-wrap">
  <div class="gallery-grid">
    {% for image in project_images %}
    {% assign caption = image.name | replace: '-', ' ' | replace: '_', ' ' | capitalize %}
    <div class="gallery-item"{% if forloop.index0 >= preview %} data-preview-hidden{% endif %}>
      <a href="{{ image.path }}"
         class="glightbox"
         data-gallery="{{ gallery_id }}"
         data-description="{{ caption }}"
         data-type="image">
        <img
          src="{{ image.path }}"
          alt="{{ caption }}"
          loading="lazy"
          class="gallery-image"
        />
        <div class="gallery-caption">{{ caption }}</div>
      </a>
    </div>
    {% endfor %}
  </div>

  {% if truncated %}
  <button class="gallery-expand-btn" id="{{ gallery_id }}-expand-btn">
    Show all {{ total }} images ↓
  </button>
  {% endif %}
</div>

<script>
(function () {
  var wrap = document.getElementById('{{ gallery_id }}-wrap');
  var expandBtn = document.getElementById('{{ gallery_id }}-expand-btn');
  if (expandBtn) {
    expandBtn.addEventListener('click', function () {
      wrap.classList.remove('gallery-truncated');
      expandBtn.style.display = 'none';
    });
  }
}());
</script>

{% endif %}
