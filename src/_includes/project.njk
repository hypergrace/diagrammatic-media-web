---
layout: simple.njk
tags: project

---
<div>
	<h1 class="h1-fill">{{ title }}</h1>
	<h5 class="h5-subtitle" style="text-align:left">{{ subtitle }} ({{ year }})</h5>


	{% if projecttags %}
		<p>
			{%- set tagArray = projecttags.split(',') -%}
			{%- for tag in tagArray -%}
				{%- set cleanTag = tag.trim() -%}
				<a href="/projects/{{ cleanTag | slug }}/">#{{ cleanTag }}</a>{% if not loop.last %}, {% endif %}
			{%- endfor -%}
		</p>
	{% endif %}

	{% if links %}
		<div class="project-links">
			{%- for link in links -%}
				<a href="{{ link.url }}" class="project-link-btn" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
			{%- endfor -%}
		</div>
	{% endif %}

	{% if collaborators %}
		<p style="text-align:right">collaboration with: 
		
		{% for collaborator in collaborators %}
			<span>{{collaborator}}{% if not loop.last %}, {% endif %}</span>
		{% endfor %}
		
		
		</p>
	{% endif %}

	<article>
		{{ content | linkifyHashtags | safe }}
	</article>
</div>

